# Copy to `.env.local` and adjust. Vite loads env files automatically.

# Use mock data for local demo (recommended until Glean API mapping is implemented).
VITE_USE_MOCK=true

# Customer instance base URL (no trailing slash), e.g. https://your-company.glean.com
VITE_GLEAN_BASE_URL=https://your-instance.glean.com

# Only use the live Glean provider when mapping is implemented and credentials exist.
# VITE_GLEAN_API_READY=true

# Only required when VITE_USE_MOCK=false, VITE_GLEAN_API_READY=true, and wiring real APIs.
# ⚠️ SECURITY: VITE_* variables are bundled into client JS — use a backend proxy in production.
VITE_GLEAN_API_KEY=
